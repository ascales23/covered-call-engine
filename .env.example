# Copy to .env and fill in YOUR OWN Alpaca PAPER keys. Never commit the real .env.
# The config loader hard-refuses to start unless the key is a paper 'PK' key and the
# endpoint is the paper URL (see config.py validate()).
ALPACA_API_KEY_ID=PK_your_paper_key_here
ALPACA_API_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER_ENDPOINT=https://paper-api.alpaca.markets

# IBKR read-only market data (optional; Alpaca data is the fallback)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=31
